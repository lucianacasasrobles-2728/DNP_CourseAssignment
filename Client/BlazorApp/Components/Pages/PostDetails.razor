@page "/posts/{Id:int}"
@rendermode InteractiveServer
@using ApiContracts
@using BlazorApp.Services
@inject IPostService PostService
@inject IUserService UserService
@inject ICommentService CommentService

<h3>Post Details</h3>

@if (post == null)
{
    <p>Post not found.</p>
}
else
{
    <h4>@post.Title</h4>

    <p>@post.Body</p>

    <p>
        <strong>Author:</strong>
        @(author?.UserName ?? "Unknown")
    </p>

    <hr />

    <h4>Comments</h4>

    @if (comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        @foreach (CommentDto comment in comments)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <p>@comment.Body</p>
                    <small>User ID: @comment.UserId</small>
                </div>
            </div>
        }
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PostDto? post;
    private UserDto? author;
    private List<CommentDto> comments = new();

    protected override async Task OnParametersSetAsync()
    {
        post = await PostService.GetPostByIdAsync(Id);

        author = null;
        comments = new List<CommentDto>();

        if (post != null)
        {
            author = await UserService.GetUserByIdAsync(post.UserId);

            comments = await CommentService.GetCommentsByPostIdAsync(Id);
        }
    }
}